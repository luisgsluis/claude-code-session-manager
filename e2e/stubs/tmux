#!/usr/bin/env bash
# tmux stub for e2e. State lives in files under $CCSM_TMUX_STATE, one per
# session; the content is "name\tcreated\ttitle".
set -u
STATE="${CCSM_TMUX_STATE:?CCSM_TMUX_STATE must be set}"
mkdir -p "$STATE"

cmd="$1"
shift

# Returns the value that follows the given flag within the call's args.
# The function's first arg is the flag to look for; the rest are the args.
flagval() {
  local flag="$1" prev=""
  for a in "${@:2}"; do
    if [ "$prev" = "$flag" ]; then printf '%s' "${a#=}"; return 0; fi
    prev="$a"
  done
  return 1
}

case "$cmd" in
  list-sessions)
    for f in "$STATE"/*; do
      [ -f "$f" ] || continue
      n="$(basename "$f")"
      # Sidecar files (.project, .size, .buffer, .paste-args, …) live next to
      # the session marker file, in this same flat dir — skip them, or their
      # content (not a real "name\tcreated\ttitle" line) gets read as a
      # phantom session. Real session names never contain a dot (CCSM's own
      # naming pattern is [A-Za-z0-9_-]{1,32}), so this is a safe filter.
      case "$n" in *.*) continue ;; esac
      proj=""
      [ -f "$STATE/$n.project" ] && proj="$(cat "$STATE/$n.project")"
      printf '%s\t%s\n' "$(cat "$f")" "$proj"
    done
    exit 0
    ;;
  has-session)
    name="$(flagval -t "$@")"
    [ -f "$STATE/$name" ] && exit 0 || exit 1
    ;;
  capture-pane)
    name="$(flagval -t "$@")"
    if [ -f "$STATE/$name" ]; then
      # Marks rc_connected: rcStatus detects the "/rc" substring on the last line.
      echo "pane-of-$name /rc"
      exit 0
    fi
    exit 1
    ;;
  new-session)
    name="$(flagval -s "$@")"
    if [ -z "$name" ]; then
      name=0
      while [ -e "$STATE/$name" ]; do name=$((name + 1)); done
    fi
    printf '%s\t%s\tclaude\n' "$name" "$(date '+%Y-%m-%d %H:%M:%S')" > "$STATE/$name"
    printf '%s\n' "$name"
    exit 0
    ;;
  kill-session)
    name="$(flagval -t "$@")"
    rm -f "$STATE/$name" "$STATE/$name.project"
    exit 0
    ;;
  set-option)
    # CCSM tags the session with its project: tmux set-option -t =<ses> @ccsm_project <project>.
    # session-resize also uses set-option (window-size manual) before resize-window;
    # only @ccsm_project is persisted here, other options are accepted and ignored,
    # same as real tmux's generic set-option.
    name="$(flagval -t "$@")"
    opt="${@: -2:1}"
    if [ "$opt" = "@ccsm_project" ]; then
      printf '%s\n' "${@: -1}" > "$STATE/$name.project"
    fi
    exit 0
    ;;
  resize-window)
    # session-resize forces an exact size: tmux resize-window -t =<ses> -x <cols> -y <rows>.
    name="$(flagval -t "$@")"
    cols="$(flagval -x "$@")"
    rows="$(flagval -y "$@")"
    printf '%sx%s\n' "$cols" "$rows" > "$STATE/$name.size"
    exit 0
    ;;
  rename-session)
    name="$(flagval -t "$@")"
    new="${@: -1}"
    [ -f "$STATE/$name" ] || { echo "no session $name" >&2; exit 1; }
    # The name lives in the file's first field: rewrite it on the move.
    content="$(cat "$STATE/$name")"
    printf '%s\t%s\n' "$new" "${content#*$'\t'}" > "$STATE/$new"
    rm -f "$STATE/$name"
    [ -f "$STATE/$name.project" ] && mv "$STATE/$name.project" "$STATE/$new.project"
    exit 0
    ;;
  send-keys)
    exit 0
    ;;
  load-buffer)
    # sendText's paste path for anything over pasteThreshold. The message
    # arrives on stdin; keep it so a test can assert what was pasted.
    cat > "$STATE/.buffer" 2>/dev/null || cat > /dev/null
    exit 0
    ;;
  paste-buffer)
    printf '%s\n' "$*" >> "$STATE/.paste-args"
    exit 0
    ;;
  delete-buffer)
    exit 0
    ;;
  *)
    echo "tmux stub: unknown command: $cmd" >&2
    exit 1
    ;;
esac
