#!/usr/bin/env bash
# tmux stub for e2e. State lives in files under $CCSM_TMUX_STATE, one per
# session; the content is "name\tcreated\ttitle".
set -u
STATE="${CCSM_TMUX_STATE:?CCSM_TMUX_STATE must be set}"
mkdir -p "$STATE"

cmd="$1"
shift

# Returns the value that follows the given flag within the call's args.
# The function's first arg is the flag to look for; the rest are the args.
flagval() {
  local flag="$1" prev=""
  for a in "${@:2}"; do
    if [ "$prev" = "$flag" ]; then printf '%s' "${a#=}"; return 0; fi
    prev="$a"
  done
  return 1
}

case "$cmd" in
  list-sessions)
    for f in "$STATE"/*; do
      [ -f "$f" ] || continue
      n="$(basename "$f")"
      proj=""
      [ -f "$STATE/$n.project" ] && proj="$(cat "$STATE/$n.project")"
      printf '%s\t%s\n' "$(cat "$f")" "$proj"
    done
    exit 0
    ;;
  has-session)
    name="$(flagval -t "$@")"
    [ -f "$STATE/$name" ] && exit 0 || exit 1
    ;;
  capture-pane)
    name="$(flagval -t "$@")"
    if [ -f "$STATE/$name" ]; then
      # Marks rc_connected: rcStatus detects the "/rc" substring on the last line.
      echo "pane-of-$name /rc"
      exit 0
    fi
    exit 1
    ;;
  new-session)
    name="$(flagval -s "$@")"
    if [ -z "$name" ]; then
      name=0
      while [ -e "$STATE/$name" ]; do name=$((name + 1)); done
    fi
    printf '%s\t%s\tclaude\n' "$name" "$(date '+%Y-%m-%d %H:%M:%S')" > "$STATE/$name"
    printf '%s\n' "$name"
    exit 0
    ;;
  kill-session)
    name="$(flagval -t "$@")"
    rm -f "$STATE/$name" "$STATE/$name.project"
    exit 0
    ;;
  set-option)
    # CCSM tags the session with its project: tmux set-option -t =<ses> @ccsm_project <project>.
    name="$(flagval -t "$@")"
    printf '%s\n' "${@: -1}" > "$STATE/$name.project"
    exit 0
    ;;
  rename-session)
    name="$(flagval -t "$@")"
    new="${@: -1}"
    [ -f "$STATE/$name" ] || { echo "no session $name" >&2; exit 1; }
    # The name lives in the file's first field: rewrite it on the move.
    content="$(cat "$STATE/$name")"
    printf '%s\t%s\n' "$new" "${content#*$'\t'}" > "$STATE/$new"
    rm -f "$STATE/$name"
    [ -f "$STATE/$name.project" ] && mv "$STATE/$name.project" "$STATE/$new.project"
    exit 0
    ;;
  send-keys)
    exit 0
    ;;
  *)
    echo "tmux stub: unknown command: $cmd" >&2
    exit 1
    ;;
esac
